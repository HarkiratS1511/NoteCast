# Copy this file to .env and fill in your key(s). Never commit the real .env.

# --- LLM provider -----------------------------------------------------------
# NoteCast talks to either AgentAUS (Trellis Data's sovereign, OpenAI-compatible
# model) or Claude (Anthropic). AgentAUS is the default on this branch. See
# docs/AGENTAUS.md for the full setup guide.

# NOTECAST_PROVIDER=agentaus

# AgentAUS settings (used when NOTECAST_PROVIDER=agentaus, the default).
# Read as plain AGENTAUS_API_KEY / AGENTAUS_BASE_URL, not prefixed like the
# settings further down.
AGENTAUS_API_KEY=
AGENTAUS_BASE_URL=https://YOUR-AGENTAUS-ENDPOINT.example.au/v1
NOTECAST_AGENTAUS_MODEL=your-agentaus-model-id

# Optional AgentAUS tuning (see docs/AGENTAUS.md for what each one is for):
# NOTECAST_AGENTAUS_HELPER_MODEL=
# NOTECAST_AGENTAUS_CONTEXT_TOKENS=128000
# NOTECAST_AGENTAUS_MAX_OUTPUT_TOKENS=8192
# NOTECAST_AGENTAUS_JSON_MODE=true
# NOTECAST_AGENTAUS_TIMEOUT_SECONDS=600
# NOTECAST_AGENTAUS_PRICE_INPUT_PER_MTOK=
# NOTECAST_AGENTAUS_PRICE_OUTPUT_PER_MTOK=

# To use Claude instead, set NOTECAST_PROVIDER=anthropic and fill in your
# Anthropic API key below. Read as plain ANTHROPIC_API_KEY, not prefixed
# like the settings further down.
# NOTECAST_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Per-role model overrides win over either provider's default if set here
# explicitly (see NOTECAST_CHAT_MODEL etc. below).

# Everything below is optional. Uncomment and edit to override a default.
# All of these are read with an NOTECAST_ prefix.

# NOTECAST_NOTEBOOKS_DIR=notebooks
# NOTECAST_CHAT_MODEL=claude-sonnet-5
# NOTECAST_HELPER_MODEL=claude-haiku-4-5
# NOTECAST_SCRIPT_MODEL=claude-sonnet-5
# NOTECAST_DEEP_MODEL=claude-sonnet-5
# NOTECAST_CHAT_EFFORT=medium
# NOTECAST_CHAT_MAX_TOKENS=8000
# NOTECAST_WEB_SEARCH_MAX_USES=3
# NOTECAST_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# NOTECAST_EMBEDDING_BACKEND=fastembed
# NOTECAST_MODEL_CACHE_DIR=.cache/models
# NOTECAST_DEVICE=auto
# NOTECAST_RETRIEVAL_TOP_K=10
# NOTECAST_RERANK_ENABLED=false
# NOTECAST_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# NOTECAST_RERANK_CANDIDATES=30
# NOTECAST_AUDIO_MAX_MINUTES=45
# NOTECAST_AUDIO_MIN_MINUTES=5
# NOTECAST_AUDIO_WORDS_PER_MINUTE=150
# NOTECAST_TTS_MODEL=fp32
# NOTECAST_HOST_A_VOICE=af_heart
# NOTECAST_HOST_B_VOICE=bm_george
# NOTECAST_TTS_SPEED=1.0
# NOTECAST_AUDIO_MP3_BITRATE=96
